# Required for LLM reviewer (paper mode + --llm-review backtest)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if you later wire signed/private BingX endpoints.
# Public spot kline/ticker endpoints used by this project do NOT require keys.
BINGX_API_KEY=
BINGX_SECRET_KEY=

# Optional — Telegram push notifications for OPEN/CLOSE/LLM-veto/errors.
# Skip if you only want console + CSV logs.
#   1. Create a bot via @BotFather, copy its HTTP API token.
#   2. Send any message to your bot, then GET
#      https://api.telegram.org/bot<TOKEN>/getUpdates  → find chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
